<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TarkovMapLite</AssemblyName>
    <RootNamespace>TarkovMapLite</RootNamespace>
    <Version>0.4.0</Version>
    <!-- 画布控件只在本程序里用，不进设计器，不需要给属性配序列化器 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- 单文件自包含：朋友机器不需要装 .NET 运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      资源只以 EmbeddedResource 形式进程序集。
      以前这里还有两条 CopyToOutputDirectory 的 Content，单文件打包会把它们
      再收进 exe 一份，于是每张图占两倍体积（296 MB 里有 70 MB 是重复的）。
      想在不重编译的情况下换图，手工把 Assets 目录放到 exe 旁边即可：
      Assets.Open 优先读旁边的散文件。
    -->
    <EmbeddedResource Include="Assets\maps\**\*.png" />
    <!-- 瓦片底图压缩成 jpg（裁掉透明边距后），楼层图仍是 png -->
    <EmbeddedResource Include="Assets\maps\**\*.jpg" />
    <EmbeddedResource Include="Assets\maps\maps.json" />
    <!-- 我这边抓取时的任务/物品数据快照：没网或第一次运行时直接可用 -->
    <EmbeddedResource Include="Assets\data-seed.json" />
    <!-- 地图静态标记：容器/散落物资/出生点/危险区，由 tools/build-markers.ps1 生成 -->
    <EmbeddedResource Include="Assets\markers.json" />
    <!-- 地名（Big Red / Dorms …）：接口里没有，由 tools/build-labels.ps1 从站点配置导出 -->
    <EmbeddedResource Include="Assets\labels.json" />
    <!-- 地名的中文对照（人工整理，站点配置里只有英文） -->
    <EmbeddedResource Include="Assets\labels-zh.json" />
    <!-- 门锁 / 闸点：由 tools/build-doors.ps1 从 /pve/maps 导出（含钥匙中文名） -->
    <EmbeddedResource Include="Assets\doors.json" />
    <!-- 闸点 → 撤离点 的手写对应表（接口里没有这个关系） -->
    <EmbeddedResource Include="Assets\switch-links.json" />
    <EmbeddedResource Include="Assets\keys.json" />
    <EmbeddedResource Include="Assets\keyicons\*.png" />
    <!-- 手机端页面：index.html / app.css / app.js，由内置的迷你 HTTP 服务发给手机 -->
    <EmbeddedResource Include="Assets\mobile\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 二维码：手机扫一下就连上，不用手打 IP（纯托管，PngByteQRCode 不依赖 GDI+） -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 回收大对象后把内存还给系统，而不是留在 GC 段里 -->
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

</Project>
